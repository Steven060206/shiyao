<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKUseWinUI>false</WindowsAppSDKUseWinUI>
    <!-- Windows App SDK otherwise selects WebView2's WinRT projection, omitting the WPF control. -->
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <MessagePurifyAppSdkVersion>2.5.1</MessagePurifyAppSdkVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MessagePurifyAppSdkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ui/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- SDK 2.5.1 omits this runtime resource from self-contained component payloads. -->
  <Target Name="CopyNotificationResource" AfterTargets="Publish">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../../packaging/probe/Copy-NotificationResource.ps1&quot; -RuntimePackageDirectory &quot;$(NuGetPackageRoot)microsoft.windowsappsdk.runtime/$(MessagePurifyAppSdkVersion)&quot; -PublishDirectory &quot;$(PublishDir).&quot;" />
  </Target>
</Project>
